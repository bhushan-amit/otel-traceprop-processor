option_settings:

  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx

  # --- OTLP HTTP process (becomes a target group on port 4318) ----------
  # Health check uses port 4318 directly; OTel returns 404 on GET /
  # which we accept as healthy via MatcherHTTPCode.
  aws:elasticbeanstalk:environment:process:otlphttp:
    Port: "4318"
    Protocol: HTTP
    HealthCheckPath: /
    MatcherHTTPCode: "404"
    HealthCheckInterval: "15"
    HealthyThresholdCount: "2"
    UnhealthyThresholdCount: "3"

  # --- ALB listener on port 4318 ----------------------------------------
  aws:elbv2:listener:4318:
    DefaultProcess: otlphttp
    Protocol: HTTP
    ListenerEnabled: "true"